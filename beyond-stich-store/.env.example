# ============================================
# BEYOND STICH — Environment Variables
# ============================================
# Copy this to .env.local and fill in your values

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/beyondstich?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
# KEY_SECRET is server-only and must never be exposed to the browser.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the publishable key used by the checkout modal
# and must match RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Transactional email (Resend). Without these, order confirmations are silently
# skipped and the owner gets no new-order alert.
RESEND_API_KEY=
EMAIL_FROM=Beyond Stich <orders@beyondstich.com>
ADMIN_ALERT_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
