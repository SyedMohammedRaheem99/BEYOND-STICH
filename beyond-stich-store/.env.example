# ============================================
# BEYOND STICH — Environment Variables
# ============================================
# Copy this to .env.local and fill in your values

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/beyondstich?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
# KEY_SECRET is server-only and must never be exposed to the browser.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the publishable key used by the checkout modal
# and must match RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Signing secret for /api/razorpay/webhook. Set it in Razorpay Dashboard →
# Settings → Webhooks (subscribe to payment.captured). Without this the
# webhook can't run, and a customer whose browser dies after paying gets no
# order. This is NOT the same value as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# ============================================
# Transactional email — SMTP (Hostinger)
# ============================================
# Mail is sent through the store's own mailbox over SMTP. Without these,
# order confirmations, password resets and signup OTPs are all skipped
# (logged to the console instead) and signup cannot complete.
#
# Hostinger: hPanel -> Emails -> the mailbox -> Configuration settings.
SMTP_HOST=smtp.hostinger.com
# 465 = implicit TLS (set SMTP_SECURE=true). 587 = STARTTLS (false).
SMTP_PORT=465
SMTP_SECURE=true
# Full address, not just the local part.
SMTP_USER=hello@beyondstich.com
SMTP_PASS=
# Must match SMTP_USER's domain, or SPF/DKIM alignment fails and mail is
# treated as spoofed no matter how the DNS is configured.
EMAIL_FROM=Beyond Stich <hello@beyondstich.com>
# Where customer replies should land — usually a monitored human mailbox,
# not the no-reply sender above.
EMAIL_REPLY_TO=hello@beyondstich.com
# Gets the "new order" alert. Without it the only way to learn about an
# order is to open the admin panel and look.
ADMIN_ALERT_EMAIL=

# Transport selector. 'smtp' (default) uses the settings above.
EMAIL_PROVIDER=smtp

# Verify the setup before any customer sees it:
#   node scripts/test-email.mjs you@gmail.com
# Then check Gmail AND Outlook AND Yahoo — each filters differently.
#
# Inbox placement also needs SPF, DKIM and DMARC on the domain's DNS.
# See AUTH-SETUP.md. Without them this mail will be marked as spam.

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# Analytics / conversion tracking
# ============================================
# Each is independent. Leave one blank and that provider is simply not
# loaded — no script, no cookie, no console error.
#
# Without these you cannot tell which ad produced a sale, what an order
# costs to acquire, or where shoppers drop out of checkout.
#
# GA4:  analytics.google.com -> Admin -> Data Streams -> your web stream
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta: business.facebook.com -> Events Manager -> Data Sources
NEXT_PUBLIC_META_PIXEL_ID=
